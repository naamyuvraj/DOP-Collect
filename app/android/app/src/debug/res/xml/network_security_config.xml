<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG BUILDS ONLY. This file lives in src/debug and overlays the release
     policy in src/main/res/xml/network_security_config.xml, which stays exactly
     as it is: cleartext forbidden everywhere, system CAs only.

     The single carve-out is the loopback host, so the sync engine can be walked
     against tool/mock_portal.py — a replay of the captured portal pages — in a
     real WebView. 10.0.2.2 is the Android emulator's alias for the development
     machine's loopback; it is not routable from anywhere else, and this file is
     not in the release APK, so the MITM path the main config closes stays shut.

     Nothing here relaxes the credential autofill guard. That is enforced
     separately in sync_screen.dart by comparing location.origin against the
     real portal, so autofill simply never runs against a mock. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
