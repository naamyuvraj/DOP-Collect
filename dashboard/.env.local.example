# Copy to .env.local and fill in. NEVER commit .env.local.
# Supabase (Settings -> API). The service_role key stays SERVER-SIDE only.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Dashboard login password + a long random session secret.
DASHBOARD_PASSWORD=change-me
AUTH_SECRET=generate-a-long-random-string

# Maximem Synap — hosted agent memory for the Assistant page (optional but
# recommended; without it the assistant still answers, just without memory).
SYNAP_MCP_URL=https://synap-mcp.maximem.ai/mcp
SYNAP_TOKEN=your_synap_token

# Groq keys for the Assistant. Optional: the agent normally reads the managed
# keys from the app_keys table (API Keys page). Comma-separated dev fallback:
# GROQ_KEYS=gsk_xxx,gsk_yyy
